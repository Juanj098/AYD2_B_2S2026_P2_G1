# Copiar como terraform.tfvars y ajustar
region               = "us-east-1"
instance_type        = "t3.micro"
ssh_public_key_path  = "~/.ssh/libreria-ayd.pub"
ssh_private_key_path = "~/.ssh/libreria-ayd"
# Su IP pública para restringir SSH, p. ej. "190.56.10.20/32"
admin_cidr = "0.0.0.0/0"
image_tag  = "latest"
