# Administrado por Ansible
PORT=3001
DB_HOST={{ db_host }}
DB_PORT=5432
DB_USER={{ db_usuario }}
DB_PASSWORD={{ db_password }}
DB_NAME={{ db_nombre }}
DB_SSL=true

# Para psql al cargar los datos iniciales
PGHOST={{ db_host }}
PGUSER={{ db_usuario }}
PGPASSWORD={{ db_password }}
PGDATABASE={{ db_nombre }}
PGSSLMODE=require
